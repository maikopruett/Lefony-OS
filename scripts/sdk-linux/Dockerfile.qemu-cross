# SPDX-License-Identifier: GPL-3.0-or-later
# Layer on Dockerfile.cross; keep each completed component's image unchanged.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN test "$(dpkg --print-architecture)" = arm64 \
    && apt-get update && apt-get install --download-only -y --no-install-recommends \
      libglib2.0-dev:amd64 libpixman-1-dev:amd64 libsdl2-dev:amd64 \
      libusb-1.0-0-dev:amd64 \
    && mkdir -p /opt/lefony-qemu-sysroot /usr/share/lefony-qemu-cross \
    && for package in /var/cache/apt/archives/*.deb; do \
         dpkg-deb -f "$package" Package Version Architecture \
           >> /usr/share/lefony-qemu-cross/packages.txt && \
         sha256sum "$package" >> /usr/share/lefony-qemu-cross/package-sha256.txt && \
         dpkg-deb -x "$package" /opt/lefony-qemu-sysroot; \
       done \
    && python3 -c 'from pathlib import Path; import sys; h=Path(sys.executable).read_bytes()[:20]; assert h[:6]==b"\x7fELF\x02\x01" and int.from_bytes(h[18:20],"little")==183' \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
RUN apt-get update && apt-get install --no-remove -y --no-install-recommends \
      python3:arm64 python3-venv python3-setuptools python3-wheel python3-pip \
    && python3 -c 'import setuptools, wheel; from pathlib import Path; import sys; h=Path(sys.executable).read_bytes()[:20]; assert int.from_bytes(h[18:20],"little")==183' \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
