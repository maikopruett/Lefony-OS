diff --git a/hw/arm/mcimx6ul-evk.c b/hw/arm/mcimx6ul-evk.c
--- a/hw/arm/mcimx6ul-evk.c
+++ b/hw/arm/mcimx6ul-evk.c
@@ -61,3 +61,10 @@
-static void hp_prime_g2_nand_boot(void *opaque)
+static void hp_prime_g2_rom_enter_image(CPUState *cpu, run_on_cpu_data data)
+{
+    cpu_reset(cpu);
+    cpu_set_pc(cpu, data.target_ptr);
+    cpu->halted = false;
+}
+
+static void hp_prime_g2_nand_boot_after_reset(void *opaque)
 {
     HPPrimeG2BootState *boot = opaque;
@@ -88,4 +95,14 @@
-    cpu_set_pc(CPU(&boot->soc->cpu), entry);
+    run_on_cpu(CPU(&boot->soc->cpu), hp_prime_g2_rom_enter_image,
+               RUN_ON_CPU_TARGET_PTR(entry));
 }
 
+static void hp_prime_g2_nand_boot(void *opaque)
+{
+    /* Legacy machine reset handlers precede SRC/CPU device reset. Read
+     * the newly latched boot override, and install the entry PC, only
+     * after all reset domains have completed. */
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            hp_prime_g2_nand_boot_after_reset, opaque);
+}
