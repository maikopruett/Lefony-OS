+static void imx7_snvs_update_irq(IMX7SNVSState *s)
+{
+    qemu_set_irq(s->irq, (s->hpsr & HPSR_BTN) != 0);
+    qemu_set_irq(s->alarm_irq, (s->hpsr & (HPSR_HPTA | HPSR_PI)) != 0);
