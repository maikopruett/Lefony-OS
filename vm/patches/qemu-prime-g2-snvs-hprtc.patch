+    frequency = extract32(s->hpcr, HPCR_PI_FREQ_SHIFT, 4);
+    interval = 1ULL << (frequency & HPCR_PI_FREQ_MASK);
+    now = imx7_snvs_get_hp_count(s) & RTC_MASK;
+    delta = interval - (now & (interval - 1));
+    delta_ns = muldiv64(delta, NANOSECONDS_PER_SECOND, RTC_FREQ);
+    timer_mod_ns(s->hp_periodic_timer,
+                 qemu_clock_get_ns(rtc_clock) + MAX(delta_ns, 1));
+}
+
+static void imx7_snvs_periodic(void *opaque)
+{
+    IMX7SNVSState *s = opaque;
+
+    if (imx7_snvs_periodic_enabled(s)) {
+        s->hpsr |= HPSR_PI;
+        imx7_snvs_update_irq(s);
+        imx7_snvs_reschedule_periodic(s);
+    }
+}
 
