+static void imx7_snvs_reschedule_alarm(IMX7SNVSState *s)
+{
+    uint64_t now, delta, delta_ns;
+
+    timer_del(s->hp_alarm_timer);
+    if (!(s->hpcr & HPCR_HPTA_EN)) {
+        return;
+    }
+
+    now = imx7_snvs_get_hp_count(s) & RTC_MASK;
+    delta = (s->hp_alarm - now) & RTC_MASK;
+    delta_ns = muldiv64(delta, NANOSECONDS_PER_SECOND, RTC_FREQ);
+    timer_mod_ns(s->hp_alarm_timer,
+                 qemu_clock_get_ns(rtc_clock) + MAX(delta_ns, 1));
+}
+
+static bool imx7_snvs_periodic_enabled(IMX7SNVSState *s)
+{
+    const uint32_t mask = HPCR_RTC_EN | HPCR_PI_EN;
+
+    return (s->hpcr & mask) == mask && !(s->hpcr & HPCR_DIS_PI);
+}
+
+static void imx7_snvs_reschedule_periodic(IMX7SNVSState *s)
+{
+    uint64_t now, interval, delta, delta_ns;
+    unsigned frequency;
+
+    timer_del(s->hp_periodic_timer);
+    if (!imx7_snvs_periodic_enabled(s)) {
+        return;
+    }
