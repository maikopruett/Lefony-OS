     qemu_irq rom_downloader;
     bool watchdog_reset_pending;
diff --git a/hw/arm/mcimx6ul-evk.c b/hw/arm/mcimx6ul-evk.c
--- a/hw/arm/mcimx6ul-evk.c
+++ b/hw/arm/mcimx6ul-evk.c
@@ -127,3 +127,10 @@
                              &error_fatal);
+    if (prime_g2_ddr_mirror) {
+        /* Read-only SRC capture from the physical Prime in ROM recovery,
+         * preserved in hardware/prime_g2/reference/rom-src-snapshot.json.
+         * Keep the captured board profile out of the generic EVK. */
+        qdev_prop_set_uint32(DEVICE(&s->src), "boot-mode1", 0x00000893);
+        qdev_prop_set_uint32(DEVICE(&s->src), "boot-mode2", 0x02000001);
+    }
     qdev_realize(DEVICE(s), NULL, &error_fatal);
 
