diff --git a/hw/misc/imx6_src.c b/hw/misc/imx6_src.c
--- a/hw/misc/imx6_src.c
+++ b/hw/misc/imx6_src.c
@@ -12,3 +12,4 @@
 #include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
 #include "hw/misc/imx6_src.h"
 #include "migration/vmstate.h"
@@ -110,3 +111,5 @@
     s->regs[SRC_SRSR] = 0x1;
     s->regs[SRC_SIMR] = 0x1F;
+    s->regs[SRC_SBMR1] = s->boot_mode1;
+    s->regs[SRC_SBMR2] = s->boot_mode2;
     if (watchdog_reset) {
@@ -207,2 +210,7 @@
     switch (index) {
+    case SRC_SBMR1:
+    case SRC_SBMR2:
+        /* Boot pins/fuse state are latched by hardware, not writable MMIO.
+         * Software boot overrides belong to SRC_GPR9/10. */
+        break;
     case SRC_SRSR:
@@ -340,2 +348,7 @@
-static void imx6_src_class_init(ObjectClass *klass, const void *data)
+static const Property imx6_src_properties[] = {
+    DEFINE_PROP_UINT32("boot-mode1", IMX6SRCState, boot_mode1, 0),
+    DEFINE_PROP_UINT32("boot-mode2", IMX6SRCState, boot_mode2, 0),
+};
+
+static void imx6_src_class_init(ObjectClass *klass, const void *data)
 {
@@ -345,3 +358,4 @@
     dc->realize = imx6_src_realize;
+    device_class_set_props(dc, imx6_src_properties);
     device_class_set_legacy_reset(dc, imx6_src_reset);
     dc->vmsd = &vmstate_imx6_src;
diff --git a/include/hw/misc/imx6_src.h b/include/hw/misc/imx6_src.h
--- a/include/hw/misc/imx6_src.h
+++ b/include/hw/misc/imx6_src.h
