     mcimx6ul_evk_common_init(machine, true);
     qemu_register_reset(hp_prime_g2_route_spis, NULL);
     hp_prime_g2_route_spis(NULL);
+
+    soc = FSL_IMX6UL(object_resolve_path_component(OBJECT(machine), "soc"));
+    if (!qtest_enabled() && !machine->kernel_filename &&
+        prime_g2_nand_has_backing()) {
+        boot = g_new0(HPPrimeG2BootState, 1);
+        boot->soc = soc;
+        qemu_register_reset(hp_prime_g2_nand_boot, boot);
+    }
 }
 
