+typedef struct HPPrimeG2BootState {
+    FslIMX6ULState *soc;
+} HPPrimeG2BootState;
+
+static void hp_prime_g2_enter_sdp(void *opaque)
+{
+    HPPrimeG2BootState *boot = opaque;
+
+    boot->soc->src.rom_downloader_active = true;
+    qemu_set_irq(boot->soc->src.rom_downloader, 1);
+}
+
+static void hp_prime_g2_nand_boot(void *opaque)
+{
+    HPPrimeG2BootState *boot = opaque;
+    Error *local_err = NULL;
+    uint32_t entry;
+
+    /* A watchdog reset after U-Boot's `bmode usb` belongs to the serial
+     * downloader.  Do not let the normal NAND path steal that reset. */
+    if (boot->soc->src.rom_downloader_active) {
+        return;
+    }
+    if (!prime_g2_nand_rom_load(&entry, &local_err)) {
+        qemu_log("hp-prime-g2-rom: NAND boot failed: %s; entering SDP\n",
+                 error_get_pretty(local_err));
+        error_free(local_err);
+        /* Device reset ordering clears SRC and USB after legacy machine
+         * reset handlers.  The real ROM starts SDP after reset completes,
+         * so defer this signal to the first main-loop iteration as well. */
+        aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                                hp_prime_g2_enter_sdp, boot);
+        return;
+    }
+    cpu_set_pc(CPU(&boot->soc->cpu), entry);
+}
