+static void prime_pwm_update_events(IMX6ULLCDIFState *s)
+{
+    /* FE watermark behavior is not implemented by this event path. */
+    bool pending = ((s->prime_pwm_regs[1] >> 3) & s->prime_pwm_regs[2] & 6) != 0;
+    if (!s->prime_pwm_timer) {
+        return;
+    }
+    qemu_set_irq(s->prime_pwm_irq, pending);
+    timer_del(s->prime_pwm_timer);
+    if (!pending && (s->prime_pwm_regs[2] & 6) &&
+        (s->prime_pwm_regs[0] & 1) && s->prime_pwm_hz) {
+        uint32_t period = MIN(s->prime_pwm_regs[4] & 0xffff, 0xfffe) + 2;
+        uint32_t count = s->prime_pwm_regs[5] % period;
+        uint32_t sample = s->prime_pwm_regs[3];
+        uint32_t distance = period - count;
+        uint64_t divisor = extract32(s->prime_pwm_regs[0], 4, 12) + 1;
+        if ((s->prime_pwm_regs[2] & 4) && sample > count && sample < period) {
+            distance = MIN(distance, sample - count);
+        }
+        uint64_t numerator = distance * divisor * NANOSECONDS_PER_SECOND - s->prime_pwm_fraction;
+        uint64_t delay = (numerator + s->prime_pwm_hz - 1) / s->prime_pwm_hz;
+        timer_mod(s->prime_pwm_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + MAX(delay, 1));
+    }
+}
+
+static void prime_pwm_advance(IMX6ULLCDIFState *s, uint64_t ticks, uint32_t period)
+{
+    uint32_t count = s->prime_pwm_regs[5] % period;
+    while (ticks) {
+        uint32_t sample = s->prime_pwm_regs[3];
+        if (!s->prime_pwm_fifo_count && !s->prime_pwm_repeat_left && ticks >= period) {
+            s->prime_pwm_regs[1] |= 0x10;
+            if (sample < period) {
+                s->prime_pwm_regs[1] |= 0x20;
+            }
+            ticks %= period; /* Skip complete identical cycles in bounded time. */
+            if (!ticks) {
+                break;
+            }
+        }
+        uint32_t step = MIN(ticks, period - count);
+        if (sample > count && sample < period && sample <= count + step) {
+            s->prime_pwm_regs[1] |= 0x20;
+        }
+        count += step;
+        ticks -= step;
+        if (count == period) {
+            count = 0;
+            s->prime_pwm_regs[1] |= 0x10;
+            prime_pwm_consume_periods(s, 1);
+            if (s->prime_pwm_regs[3] == 0) {
+                s->prime_pwm_regs[1] |= 0x20;
+            }
+        }
+    }
+    s->prime_pwm_regs[5] = count;
+}
+
 static void prime_pwm_sync(IMX6ULLCDIFState *s)
@@ -960,2 +1026,1 @@
-        prime_pwm_consume_periods(s, (s->prime_pwm_regs[5] + ticks) / period);
-        s->prime_pwm_regs[5] = (s->prime_pwm_regs[5] + ticks) % period;
+        prime_pwm_advance(s, ticks, period);
