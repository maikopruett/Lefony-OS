+static bool prime_iomux_register(IMX6ULLCDIFState *s, hwaddr offset,
+                                 uint32_t expected)
+{
+    return offset < PRIME_IOMUX_SIZE &&
+           s->prime_iomux_regs[offset >> 2] == expected;
+}
+
+static bool prime_panel_iomux_ready(IMX6ULLCDIFState *s)
+{
+    hwaddr mux;
+    hwaddr pad;
+
+    if (s->prime_fault_iomux) {
+        return false;
+    }
+    for (mux = 0x118, pad = 0x3a4; mux <= 0x134; mux += 4, pad += 4) {
+        if (!prime_iomux_register(s, mux, 0) ||
+            !prime_iomux_register(s, pad, 0x79)) {
+            return false;
+        }
+    }
+    return prime_iomux_register(s, 0x104, 0) &&
+           prime_iomux_register(s, 0x390, 0x79) &&
+           prime_iomux_register(s, 0x108, 0) &&
+           prime_iomux_register(s, 0x394, 0x79) &&
+           prime_iomux_register(s, 0x10c, 0) &&
+           prime_iomux_register(s, 0x398, 0x79) &&
+           prime_iomux_register(s, 0x110, 0) &&
+           prime_iomux_register(s, 0x39c, 0x79) &&
+           prime_iomux_register(s, 0x114, 5) &&
+           prime_iomux_register(s, 0x3a0, 0x17059) &&
+           prime_iomux_register(s, 0x1e4, 5) &&
+           prime_iomux_register(s, 0x470, 0x70a1) &&
+           prime_iomux_register(s, 0x1e8, 5) &&
+           prime_iomux_register(s, 0x474, 0x70a1) &&
+           prime_iomux_register(s, 0x1ec, 5) &&
+           prime_iomux_register(s, 0x478, 0x70a1) &&
+           prime_iomux_register(s, 0x1dc, 6) &&
+           prime_iomux_register(s, 0x468, 0x110b0) &&
+           prime_iomux_register(s, 0x1d0, 5) &&
+           prime_iomux_register(s, 0x45c, 0x17059);
+}
+
+static uint64_t prime_panel_pixel_clock_hz(IMX6ULLCDIFState *s)
+{
+    uint32_t cscdr2;
+    uint32_t cbcmr;
+    uint32_t pred;
+    uint32_t podf;
+
+    if (!s->prime_ccm) {
+        return 0;
+    }
+    cscdr2 = s->prime_ccm->ccm[CCM_CSCDR2];
+    cbcmr = s->prime_ccm->ccm[CCM_CBCMR];
+    if (((cscdr2 >> 15) & 7) != 0 || ((cscdr2 >> 9) & 7) != 0 ||
+        ((s->prime_ccm->ccm[CCM_CCGR2] >> 28) & 3) == 0 ||
+        ((s->prime_ccm->ccm[CCM_CCGR3] >> 10) & 3) == 0) {
+        return 0;
+    }
+    pred = ((cscdr2 >> 12) & 7) + 1;
+    podf = ((cbcmr >> 23) & 7) + 1;
+    return 528000000ULL / pred / podf;
+}
+
+static bool prime_panel_timing_ready(IMX6ULLCDIFState *s)
+{
+    uint32_t vdctrl0 = s->regs[0x70 >> 4];
+    uint32_t vdctrl1 = s->regs[0x80 >> 4];
+    uint32_t vdctrl2 = s->regs[0x90 >> 4];
+    uint32_t vdctrl3 = s->regs[0xa0 >> 4];
+    uint32_t vdctrl4 = s->regs[0xb0 >> 4];
+    uint32_t htotal = vdctrl2 & 0x3ffff;
+    uint32_t hsync = vdctrl2 >> 18;
+    uint32_t hwait = (vdctrl3 >> 16) & 0xfff;
+    uint32_t vwait = vdctrl3 & 0xffff;
+    uint64_t pixel_clock = prime_panel_pixel_clock_hz(s);
+    uint64_t refresh_millihz;
+
+    if (s->prime_fault_timing || htotal == 0 || vdctrl1 == 0) {
+        return false;
+    }
+    refresh_millihz = pixel_clock * 1000 / htotal / vdctrl1;
+    return pixel_clock >= 16200000 && pixel_clock <= 19800000 &&
+           refresh_millihz >= 55000 && refresh_millihz <= 65000 &&
+           hsync == 1 && hwait >= 65 && hwait <= 79 &&
+           htotal - PRIME_PANEL_WIDTH * 3 - hwait >= 90 &&
+           htotal - PRIME_PANEL_WIDTH * 3 - hwait <= 110 &&
+           (vdctrl0 & 0x3ffff) == 1 && vdctrl1 >= 262 && vdctrl1 <= 266 &&
+           vwait >= 16 && vwait <= 20 &&
+           vdctrl1 - PRIME_PANEL_HEIGHT - vwait >= 4 &&
+           vdctrl1 - PRIME_PANEL_HEIGHT - vwait <= 8 &&
+           (vdctrl4 & 0x3ffff) == PRIME_PANEL_WIDTH * 3;
+}
+
+static bool prime_panel_polarity_ready(IMX6ULLCDIFState *s)
+{
+    uint32_t vdctrl0 = s->regs[0x70 >> 4];
+    uint32_t vdctrl4 = s->regs[0xb0 >> 4];
+    uint32_t required = (1u << 28) | (1u << 24) |
+                        (1u << 21) | (1u << 20);
+
+    return !s->prime_fault_polarity && (vdctrl0 & required) == required &&
+           !(vdctrl0 & ((1u << 27) | (1u << 26) | (1u << 25))) &&
+           (vdctrl4 & (1u << 18)) && !(vdctrl4 & (7u << 29));
+}
+
+static bool prime_panel_power_timing_ready(IMX6ULLCDIFState *s)
+{
+    return !s->prime_fault_power && !s->prime_power_timing_bad &&
+           s->prime_reset_release_ns >= 0 && s->prime_power_on_ns >= 0;
+}
+
+static bool prime_panel_fifo_ready(IMX6ULLCDIFState *s, uint32_t frame_base)
+{
+    uint32_t outstanding = (s->regs[0x20 >> 4] >> 21) & 7;
+
+    return outstanding >= 3 && !(frame_base & 0x3f);
+}
