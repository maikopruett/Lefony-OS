+/* Prime NAND root clocks in RUN mode. PLL/PFD settling and low-power
+ * transitions still require board-level qualification. Unknown external
+ * bypass inputs are unavailable, never substituted with a fixed rate. */
+static uint64_t imx6ul_nand_root_hz(IMX6ULCCMState *s, bool bch)
+{
+    uint32_t pll = s->analog[CCM_ANALOG_PLL_SYS];
+    unsigned select = (s->ccm[CCM_CSCMR1] >> (bch ? 18 : 19)) & 1;
+    unsigned lane = (s->analog[CCM_ANALOG_PFD_528] >> (select ? 0 : 16)) & 255;
+    unsigned frac = lane & 63;
+    unsigned div = ((s->ccm[CCM_CSCDR1] >> (bch ? 19 : 22)) & 7) + 1;
+    unsigned gate4 = (s->ccm[CCM_CCGR4] >> (bch ? 26 : 28)) & 3;
+    unsigned gate6 = (s->ccm[CCM_CCGR6] >> (bch ? 6 : 8)) & 3;
+    uint64_t parent;
+    /* 00 off, 01 RUN, 11 all modes. 10 is not a supported gate encoding. */
+    if (!(gate4 & 1) || !(gate6 & 1) || !(pll & (1u << 13)) ||
+        (lane & 128) || frac < 12 || frac > 35) {
+        return 0;
+    }
+    if (pll & (1u << 16)) {
+        if ((pll >> 14) & 3) {
+            return 0;
+        }
+        parent = CKIH_FREQ;
+    } else {
+        if (pll & (1u << 12)) {
+            return 0;
+        }
+        parent = (uint64_t)CKIH_FREQ * ((pll & 1) ? 22 : 20);
+    }
+    return parent * 18 / frac / div;
+}
+
+static void imx6ul_update_nand_clocks(IMX6ULCCMState *s)
+{
+    clock_update_hz(s->gpmi_clock, imx6ul_nand_root_hz(s, false));
+    clock_update_hz(s->bch_clock, imx6ul_nand_root_hz(s, true));
+}
+
+static int imx6ul_nand_clocks_post_load(void *opaque, int version_id)
+{
+    imx6ul_update_nand_clocks(opaque);
+    return 0;
+}
