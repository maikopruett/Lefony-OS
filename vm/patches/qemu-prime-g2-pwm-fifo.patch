+static void prime_pwm_fifo_reset(IMX6ULLCDIFState *s)
+{
+    memset(s->prime_pwm_fifo, 0, sizeof(s->prime_pwm_fifo));
+    s->prime_pwm_fifo_head = s->prime_pwm_fifo_count = 0;
+    s->prime_pwm_repeat_left = 0;
+    s->prime_pwm_regs[1] = s->prime_pwm_regs[3] = 0;
+}
+
+static void prime_pwm_consume_periods(IMX6ULLCDIFState *s, uint64_t periods)
+{
+    /* Nominal period-boundary consumption; empty-FIFO silicon glitches
+     * and exact first-enable edge timing require physical qualification. */
+    while (periods && (s->prime_pwm_fifo_count || s->prime_pwm_repeat_left)) {
+        periods--;
+        if (s->prime_pwm_repeat_left > 1) {
+            s->prime_pwm_repeat_left--;
+        } else if (s->prime_pwm_fifo_count) {
+            s->prime_pwm_regs[3] = s->prime_pwm_fifo[s->prime_pwm_fifo_head];
+            s->prime_pwm_fifo_head = (s->prime_pwm_fifo_head + 1) & 3;
+            s->prime_pwm_fifo_count--;
+            s->prime_pwm_repeat_left = 1u << extract32(s->prime_pwm_regs[0], 1, 2);
+        } else {
+            s->prime_pwm_repeat_left = 0; /* retain the final active sample */
+        }
+    }
+}
+
