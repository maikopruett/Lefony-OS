+/* Board switch changes are input edges even when the CPU is sleeping. */
+void imx_gpio_sample_board(void *opaque)
+{
+    IMXGPIOState *s = IMX_GPIO(opaque);
+    unsigned line;
+    uint32_t levels;
+    if (!s->board_pad_sample) {
+        return;
+    }
+    levels = s->board_pad_sample(s->gdir, s->dr);
+    for (line = 1; line < 16; line++) {
+        if (!(s->gdir & (1u << line))) {
+            imx_gpio_set(s, line, (levels >> line) & 1);
+        }
+    }
+}
