--- a/hw/arm/fsl-imx6ul.c
+++ b/hw/arm/fsl-imx6ul.c
@@ -19,6 +19,8 @@
 #include "qemu/osdep.h"
 #include "qapi/error.h"
 #include "hw/arm/fsl-imx6ul.h"
+#include "hw/arm/prime_g2_peripherals.h"
+#include "hw/i2c/i2c.h"
 #include "hw/display/imx6ul_lcdif.h"
 #include "hw/misc/unimp.h"
 #include "hw/usb/imx-usb-phy.h"
@@ -394,6 +395,49 @@
 
         sysbus_connect_irq(SYS_BUS_DEVICE(&s->i2c[i]), 0,
                            qdev_get_gpio_in(gic, FSL_IMX6UL_I2Cn_IRQ[i]));
+    }
+
+    /* HP Prime G2 board devices on the captured buses. */
+    {
+        I2CSlave *pf1550 = i2c_slave_create_simple(
+            s->i2c[0].bus, TYPE_PRIME_G2_PF1550, 0x08);
+        qdev_connect_gpio_out_named(DEVICE(pf1550), "irq", 0,
+            qdev_get_gpio_in(DEVICE(&s->gpio[4]), 4));
+    }
+    {
+        I2CSlave *goodix = i2c_slave_create_simple(
+            s->i2c[1].bus, TYPE_PRIME_G2_GOODIX, 0x14);
+        qdev_connect_gpio_out(DEVICE(&s->gpio[0]), 24,
+            qdev_get_gpio_in_named(DEVICE(goodix), "reset", 0));
+        qdev_connect_gpio_out_named(DEVICE(goodix), "irq", 0,
+            qdev_get_gpio_in(DEVICE(&s->gpio[0]), 25));
+    }
+    {
+        DeviceState *ilitek = DEVICE(i2c_slave_create_simple(
+            s->i2c[1].bus, TYPE_PRIME_G2_ILITEK, 0x26));
+        qdev_connect_gpio_out_named(ilitek, "irq", 0,
+            qdev_get_gpio_in(DEVICE(&s->gpio[0]), 25));
+    }
+
+    {
+        DeviceState *kpp = qdev_new(TYPE_PRIME_G2_KPP);
+        SysBusDevice *ksbd = SYS_BUS_DEVICE(kpp);
+        sysbus_realize_and_unref(ksbd, &error_abort);
+        sysbus_mmio_map(ksbd, 0, FSL_IMX6UL_KPP_ADDR);
+        sysbus_connect_irq(ksbd, 0,
+                           qdev_get_gpio_in(gic, FSL_IMX6UL_KPP_IRQ));
+    }
+
+    {
+        DeviceState *nand = qdev_new(TYPE_PRIME_G2_NAND);
+        SysBusDevice *nsbd = SYS_BUS_DEVICE(nand);
+        sysbus_realize_and_unref(nsbd, &error_abort);
+        sysbus_mmio_map(nsbd, 0, FSL_IMX6UL_GPMI_ADDR);
+        sysbus_mmio_map(nsbd, 1, FSL_IMX6UL_BCH_ADDR);
+        sysbus_connect_irq(nsbd, 0,
+                           qdev_get_gpio_in(gic, FSL_IMX6UL_RAWNAND1_IRQ));
+        sysbus_connect_irq(nsbd, 1,
+                           qdev_get_gpio_in(gic, FSL_IMX6UL_RAWNAND2_IRQ));
     }
 
