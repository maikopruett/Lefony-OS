+static bool prime_panel_registers_ready(IMX6ULLCDIFState *s)
+{
+    static const uint8_t gamma[] = {
+        0xa7, 0x55, 0x71, 0x71, 0x73, 0x55, 0x18, 0x62,
+    };
+    int i;
+
+    if (s->prime_panel_regs[0x01] != 0x14 ||
+        s->prime_panel_regs[0x02] != 0x3a ||
+        s->prime_panel_regs[0x05] != 0xef ||
+        s->prime_panel_regs[0x30] != 0x0d) {
+        return false;
+    }
+    for (i = 0; i < ARRAY_SIZE(gamma); i++) {
+        if (s->prime_panel_regs[0x10 + i] != gamma[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool prime_panel_backlight_ready(IMX6ULLCDIFState *s)
+{
+    return (s->prime_pwm_regs[0] & 1) && s->prime_pwm_regs[3] != 0 &&
+           s->prime_pwm_regs[4] != 0;
+}
+
+static int prime_panel_blank_reason(IMX6ULLCDIFState *s, uint32_t ctrl,
+                                    uint32_t transfer_width, uint32_t height)
+{
+    if (!s->prime_panel_supply) {
+        return PRIME_PANEL_NO_SUPPLY;
+    }
+    if (!prime_panel_backlight_ready(s)) {
+        return PRIME_PANEL_NO_BACKLIGHT;
+    }
+    if (!s->prime_panel_reset_released) {
+        return PRIME_PANEL_RESET_INCOMPLETE;
+    }
+    if (!prime_panel_registers_ready(s)) {
+        return PRIME_PANEL_NOT_CONFIGURED;
+    }
+    if (FIELD_EX32(ctrl, CTRL, WORD_LENGTH) != CTRL_WORD_LENGTH_8 ||
+        !(ctrl & (1u << 14)) || transfer_width != PRIME_PANEL_WIDTH * 3 ||
+        height != PRIME_PANEL_HEIGHT) {
+        return PRIME_PANEL_BAD_LCDIF_MODE;
+    }
+    return PRIME_PANEL_VISIBLE;
+}
+
+static const char *prime_panel_blank_reason_name(int reason)
+{
+    switch (reason) {
+    case PRIME_PANEL_VISIBLE: return "visible";
+    case PRIME_PANEL_NO_SUPPLY: return "panel supply GPIO2_IO21 is low";
+    case PRIME_PANEL_NO_BACKLIGHT: return "PWM7 backlight is disabled";
+    case PRIME_PANEL_RESET_INCOMPLETE: return "panel reset pulse is incomplete";
+    case PRIME_PANEL_NOT_CONFIGURED: return "ILI9322 register sequence is incomplete";
+    case PRIME_PANEL_BAD_LCDIF_MODE: return "LCDIF is not in Prime 8-bit serial-RGB mode";
+    default: return "unknown";
+    }
+}
+
+static void prime_panel_invalidate(IMX6ULLCDIFState *s)
+{
+    s->invalidate = true;
+    if (s->con) {
+        qemu_console_hw_invalidate(s->con);
+    }
+}
+
+static void prime_panel_set_input(void *opaque, int line, int level)
+{
+    IMX6ULLCDIFState *s = opaque;
+    bool high = !!level;
+
+    switch (line) {
+    case PRIME_PANEL_SUPPLY:
+        s->prime_panel_supply = high;
+        break;
+    case PRIME_PANEL_RESET:
+        if (!high) {
+            s->prime_panel_reset_seen_low = true;
+            s->prime_panel_reset_released = false;
+            memset(s->prime_panel_regs, 0, sizeof(s->prime_panel_regs));
+        } else if (!s->prime_panel_reset && s->prime_panel_reset_seen_low) {
+            s->prime_panel_reset_released = true;
+        }
+        s->prime_panel_reset = high;
+        break;
+    case PRIME_PANEL_SPI_CLOCK:
+        if (!s->prime_spi_cs && !s->prime_spi_clock && high) {
+            s->prime_spi_shift = (s->prime_spi_shift << 1) |
+                                 s->prime_spi_mosi;
+            s->prime_spi_bits++;
+        }
+        s->prime_spi_clock = high;
+        break;
+    case PRIME_PANEL_SPI_CS:
+        if (s->prime_spi_cs && !high) {
+            s->prime_spi_bits = 0;
+            s->prime_spi_shift = 0;
+        } else if (!s->prime_spi_cs && high && s->prime_spi_bits == 16) {
+            uint8_t address = s->prime_spi_shift >> 8;
+            uint8_t value = s->prime_spi_shift;
+
+            if (!s->prime_fault_spi) {
+                s->prime_panel_regs[address] = value;
+            }
+            qemu_log_mask(LOG_UNIMP,
+                          "prime-g2-panel: ILI9322 reg 0x%02x = 0x%02x\n",
+                          address, value);
+        }
+        s->prime_spi_cs = high;
+        break;
+    case PRIME_PANEL_SPI_MOSI:
+        s->prime_spi_mosi = high;
+        break;
+    default:
+        return;
+    }
+    prime_panel_invalidate(s);
+}
+
+static void prime_panel_draw_black(IMX6ULLCDIFState *s)
+{
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    int y;
+
+    if (surface_width(surface) != PRIME_PANEL_WIDTH ||
+        surface_height(surface) != PRIME_PANEL_HEIGHT) {
+        qemu_console_resize(s->con, PRIME_PANEL_WIDTH, PRIME_PANEL_HEIGHT);
+        surface = qemu_console_surface(s->con);
+    }
+    for (y = 0; y < PRIME_PANEL_HEIGHT; y++) {
+        memset(surface_data(surface) + y * surface_stride(surface), 0,
+               PRIME_PANEL_WIDTH * 4);
+    }
+    qemu_console_update(s->con, 0, 0, PRIME_PANEL_WIDTH, PRIME_PANEL_HEIGHT);
+}
