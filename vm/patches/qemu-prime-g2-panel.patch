+static uint64_t prime_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX6ULLCDIFState *s = opaque;
+
+    return s->prime_pwm_regs[offset >> 2];
+}
+
+static void prime_pwm_write(void *opaque, hwaddr offset, uint64_t value,
+                            unsigned size)
+{
+    IMX6ULLCDIFState *s = opaque;
+
+    qemu_log_mask(LOG_UNIMP, "prime-g2-panel: PWM7[0x%02" HWADDR_PRIx
+                  "] = 0x%08" PRIx64 "\n", offset, value);
+    s->prime_pwm_regs[offset >> 2] = value;
+    if (offset == 0) {
+        /* i.MX PWM software reset is self-clearing. */
+        s->prime_pwm_regs[0] &= ~(1u << 3);
+    }
+    prime_panel_invalidate(s);
+}
