-
-    if (offset == 0x14 && (s->prime_pwm_regs[0] & 1) &&
+    if ((s->prime_pwm_regs[0] & 1) &&
         s->prime_pwm_enable_ns >= 0) {
         uint32_t prescaler = extract32(s->prime_pwm_regs[0], 4, 12) + 1;
-        /* 0xffff has the same period as 0xfffe: the counter is 16-bit. */
         uint32_t period = MIN(s->prime_pwm_regs[4] & 0xffff, 0xfffe) + 2;
-        uint64_t elapsed = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) -
-                           s->prime_pwm_enable_ns;
-        uint64_t ticks = muldiv64(elapsed, prime_pwm_source_hz(s),
-                                  NANOSECONDS_PER_SECOND) / prescaler;
-
-        return (s->prime_pwm_regs[5] + ticks) % period;
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        uint64_t elapsed = MAX(now - s->prime_pwm_enable_ns, 0);
+        uint64_t whole = muldiv64(elapsed, s->prime_pwm_hz, NANOSECONDS_PER_SECOND);
+        uint64_t part = ((elapsed % NANOSECONDS_PER_SECOND) * s->prime_pwm_hz)
+                        % NANOSECONDS_PER_SECOND;
+        uint64_t denominator = (uint64_t)NANOSECONDS_PER_SECOND * prescaler;
+        uint64_t fraction = s->prime_pwm_fraction + part +
+                            (whole % prescaler) * NANOSECONDS_PER_SECOND;
+        uint64_t ticks = whole / prescaler + fraction / denominator;
+        s->prime_pwm_fraction = fraction % denominator;
+        s->prime_pwm_regs[5] = (s->prime_pwm_regs[5] + ticks) % period;
+        s->prime_pwm_enable_ns = now;
     }
+}
 
+static void prime_pwm_clock_changed(void *opaque, ClockEvent event)
+{
+    IMX6ULLCDIFState *s = opaque;
+    /* Account with the old rate before adopting newly published roots. */
+    prime_pwm_sync(s);
+    s->prime_pwm_hz = prime_pwm_source_hz(s);
+}
+
+static uint64_t prime_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX6ULLCDIFState *s = opaque;
+    if (offset == 0x14) {
+        prime_pwm_sync(s);
+    }
     return s->prime_pwm_regs[offset >> 2];
 }
