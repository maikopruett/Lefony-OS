diff --git a/lib/elf.c b/lib/elf.c
--- a/lib/elf.c
+++ b/lib/elf.c
@@ -280,6 +280,17 @@ unsigned long load_elf_image_shdr(unsigned long addr)
 	return ehdr->e_entry;
 }
 
+static int valid_native_load_range(ulong start, ulong end)
+{
+	if (end < start)
+		return 0;
+
+	return (start >= 0x82000000 && end <= 0x85000000) ||
+	       /* The linker reserves one MiB for the 320x240 framebuffer,
+		* including small before/after guards used by emulator diagnostics. */
+	       (start >= 0x8f000000 && end <= 0x8f100000);
+}
+
 /*
  * Determine if a valid ELF image exists at the given memory location.
  * First look at the ELF header magic field, then make sure that it is
@@ -288,6 +299,9 @@ unsigned long load_elf_image_shdr(unsigned long addr)
 int valid_elf_image(unsigned long addr)
 {
 	Elf32_Ehdr *ehdr; /* Elf header structure pointer */
+	Elf32_Phdr *phdr;
+	ulong payload_size;
+	int i;
 
 	ehdr = (Elf32_Ehdr *)addr;
 
@@ -301,5 +315,41 @@ int valid_elf_image(unsigned long addr)
 		return 0;
 	}
 
+	payload_size = env_get_hex("filesize", 0);
+	if (ehdr->e_ident[EI_CLASS] != ELFCLASS32 ||
+	    ehdr->e_ident[EI_DATA] != ELFDATA2LSB ||
+	    ehdr->e_machine != EM_ARM ||
+	    ehdr->e_phentsize != sizeof(*phdr) || !payload_size ||
+	    ehdr->e_phoff > payload_size ||
+	    (ulong)ehdr->e_phnum >
+		(payload_size - ehdr->e_phoff) / sizeof(*phdr)) {
+		printf("## Invalid native ELF header or program-header table\n");
+		return 0;
+	}
+
+	phdr = (Elf32_Phdr *)(addr + ehdr->e_phoff);
+	for (i = 0; i < ehdr->e_phnum; ++i, ++phdr) {
+		ulong segment_end;
+
+		if (phdr->p_type != PT_LOAD)
+			continue;
+		if (phdr->p_filesz > phdr->p_memsz ||
+		    phdr->p_offset > payload_size ||
+		    phdr->p_filesz > payload_size - phdr->p_offset) {
+			printf("## Native ELF segment exceeds payload bounds\n");
+			return 0;
+		}
+		segment_end = phdr->p_paddr + phdr->p_memsz;
+		if (!valid_native_load_range(phdr->p_paddr, segment_end)) {
+			printf("## ELF load segment outside native memory map\n");
+			return 0;
+		}
+	}
+
+	if (ehdr->e_entry < 0x82000000 || ehdr->e_entry >= 0x85000000) {
+		printf("## Native ELF entry point outside executable memory\n");
+		return 0;
+	}
+
 	return 1;
 }
