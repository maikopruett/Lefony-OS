diff --git a/apps/apps_container.cpp b/apps/apps_container.cpp
--- a/apps/apps_container.cpp
+++ b/apps/apps_container.cpp
@@ -227,7 +227,15 @@ bool AppsContainer::dispatchEvent(Ion::Events::Event event) {
         return true;
       }
     }
-    didProcessEvent = Container::dispatchEvent(event);
+#if defined(PLATFORM_PRIME_G2)
+    // Dedicated Prime navigation keys are global and must not be consumed by
+    // the current responder (notably Home::Controller's old Home behavior).
+    if (event == Ion::Events::Home || event == Ion::Events::CAS ||
+        event == Ion::Events::Apps) {
+      didProcessEvent = processEvent(event);
+    } else
+#endif
+    { didProcessEvent = Container::dispatchEvent(event); }
   }
 
   if (!didProcessEvent) {
@@ -258,8 +266,18 @@ bool AppsContainer::processEvent(Ion::Events::Event event) {
     }
     return true;
   }
-  // If key home or key back is pressed, we switch to the home app.
-  if (event == Ion::Events::Home || event == Ion::Events::Back) {
+#if defined(PLATFORM_PRIME_G2)
+  // Prime HOME and CAS both enter the primary calculator. APPS opens the
+  // launcher, while Esc/Back retains its existing launcher behavior.
+  if (event == Ion::Events::Home || event == Ion::Events::CAS) {
+    switchTo(appSnapshotAtIndex(1));
+    return true;
+  }
+  if (event == Ion::Events::Apps || event == Ion::Events::Back) {
+#else
+  // On NumWorks, Home and Back both open the application launcher.
+  if (event == Ion::Events::Home || event == Ion::Events::Back) {
+#endif
     switchTo(appSnapshotAtIndex(0));
     return true;
   }
