# U-Boot text environment for the emulator A/B NAND layout.
# Generated capsules are verified before this environment is installed.
bootlimit=3
upsilon_a_offset=0x00400000
upsilon_b_offset=0x1f000000
upsilon_slot_size=0x00800000
upsilon_loadaddr=0x80800000
upsilon_boot_a=nand read ${upsilon_loadaddr} ${upsilon_a_offset} ${upsilon_a_bytes}; hash sha256 ${upsilon_loadaddr} ${upsilon_a_bytes} upsilon_actual; if test ${upsilon_actual} = ${upsilon_a_sha256}; then mw.l 0x87fff000 0x3142464c; mw.l 0x87fff004 0; nand read ${fdt_addr} 0xc00000 0x100000; bootz ${upsilon_loadaddr} - ${fdt_addr}; fi
upsilon_boot_b=nand read ${upsilon_loadaddr} ${upsilon_b_offset} ${upsilon_b_bytes}; hash sha256 ${upsilon_loadaddr} ${upsilon_b_bytes} upsilon_actual; if test ${upsilon_actual} = ${upsilon_b_sha256}; then mw.l 0x87fff000 0x3142464c; mw.l 0x87fff004 1; nand read ${fdt_addr} 0xc00000 0x100000; bootz ${upsilon_loadaddr} - ${fdt_addr}; fi
upsilon_rescue=echo Lefony: both native slots invalid - entering read-only recovery; setenv bootdelay -1
upsilon_choose=if test -n "${upsilon_pending}"; then setexpr upsilon_attempts ${upsilon_attempts} + 1; if test ${upsilon_attempts} -gt ${bootlimit}; then echo Lefony: pending slot exhausted, rolling back; setenv upsilon_pending; setenv upsilon_attempts 0; saveenv; else saveenv; run upsilon_boot_${upsilon_pending}; fi; fi; run upsilon_boot_${upsilon_active}; run upsilon_rescue
bootcmd=run upsilon_choose
