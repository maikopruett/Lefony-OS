+/* Service an inherited watchdog during RAM recovery, but never arm it.
+ * Ordinary NAND boots preserve the board's existing watchdog policy. */
+void hw_watchdog_reset(void)
+{
+	if (readw(WDOG1_BASE_ADDR) & 4) {
+		writew(0x5555, WDOG1_BASE_ADDR + 2);
+		writew(0xaaaa, WDOG1_BASE_ADDR + 2);
+	}
+}
+
 int board_late_init(void)
 {
+	/* Lefony recovery protocol v1. SNVS_LPGPR is retained across reset.
+	 * Only this token is ours: preserve WDGR and pending-slot LFOK tokens.
+	 * Clear and read back BEFORE USB setup; RESET must boot NAND normally.
+	 * SRC GPRs are reserved for ROM and are deliberately not used here. */
+	volatile u32 *request = (u32 *)(SNVS_BASE_ADDR + 0x68);
+	volatile u32 *cap = (u32 *)0x80001000;
+	int recovery = readl(request) == 0x3153464c; /* LFS1 */
+	if (recovery) {
+		int retries = 100;
+		writel(0, request);
+		while (readl(request) != 0 && retries-- > 0)
+			udelay(100);
+		if (readl(request) != 0)
+			recovery = 0;
+	}
+	/* Publish support only when actually handing off to native firmware.
+	 * A RESET during RAM testing must not leave a stale capability cookie
+	 * for the older bootloader still installed in NAND. */
+	writel(0, cap);
+	writel(0, cap + 1);
+	writel(0, cap + 2);
+	flush_dcache_range(0x80001000, 0x80001040);
+	if (recovery) {
+		puts("Lefony: consumed one-shot SDP request\n");
+		run_command("sdp 0", 0);
+		puts("Lefony: SDP ended; continuing normal NAND boot\n");
+	}
+	writel(0x4255464c, cap); /* LFUB */
+	writel(~0x4255464cU, cap + 1);
+	writel(1, cap + 2);
+	flush_dcache_range(0x80001000, 0x80001040);
+
 #ifdef CONFIG_CMD_BMODE
 	add_board_boot_modes(board_boot_modes);
 #endif
